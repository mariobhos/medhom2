# ---------------------------------------------------------------------------
# MedHome environment variables
# Copy this file to `.env.local` for local development and fill in real values.
# Never commit `.env.local` or any file containing real secrets.
# Production values are configured in Vercel -> Project -> Settings -> Environment Variables.
# ---------------------------------------------------------------------------

# PostgreSQL connection string for the application (server-side only).
# In production this is provided by the Neon Postgres integration on Vercel.
# Example: postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL=

# Secret used to sign the owner session cookie (HS256 JWT).
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# bcrypt hash of the single owner password. The plaintext password is NEVER stored.
# Generate one with: npm run hash-password -- "your-password-here"
# Note: if the hash contains `$` characters, keep it single-quoted in shells.
OWNER_PASSWORD_HASH=

# Optional: session lifetime in days (default 30).
SESSION_TTL_DAYS=30
